[Unit]
Description=Vigilar cambios en listas de paquetes

[Path]

PathChanged= %h/dotfiles/bash/
PathChanged= %h/dotfiles/oh-my-posh/
PathChanged= %h/dotfiles/pkglist/
PathChanged= %h/dotfiles/systemd/
PathChanged= %h/dotfiles/konsole/
PathChanged= %h/dotfiles/kde/.config/
PathChanged= %h/dotfiles/kde/.local/
PathChanged= %h/dotfiles/kde/wallpapers/
PathChanged= %h/dotfiles/.gitignore

[Install]
WantedBy=default.target
